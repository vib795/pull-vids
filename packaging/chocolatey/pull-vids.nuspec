<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pull-vids</id>
    <version>$version$</version>
    <packageSourceUrl>https://github.com/vib795/pull-vids/tree/develop/packaging/chocolatey</packageSourceUrl>
    <owners>vib795</owners>

    <title>pull-vids (Install)</title>
    <authors>Utkarsh Singh</authors>
    <projectUrl>https://github.com/vib795/pull-vids</projectUrl>
    <!-- CPMR0041 wants a CDN-backed icon. jsDelivr is pinned to the commit that
         introduced assets/icon.png rather than to a branch, so the bytes behind
         this URL can never change under an already-published package version.
         Regenerate with assets/make-icon.py, then repoint this at the new commit. -->
    <iconUrl>https://cdn.jsdelivr.net/gh/vib795/pull-vids@27832f3d6de3926508861ea83fa2345d5bdc3bb4/assets/icon.png</iconUrl>
    <copyright>Copyright (c) Utkarsh Singh</copyright>
    <licenseUrl>https://github.com/vib795/pull-vids/blob/develop/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <!-- projectSourceUrl is deliberately omitted (CPMR0033): projectUrl already
         points at the source repository, so duplicating it adds no information. -->
    <docsUrl>https://github.com/vib795/pull-vids#readme</docsUrl>
    <bugTrackerUrl>https://github.com/vib795/pull-vids/issues</bugTrackerUrl>
    <tags>pull-vids video downloader youtube yt-dlp cli golang</tags>
    <summary>Universal video downloader CLI supporting 1000+ websites</summary>
    <description><![CDATA[
pull-vids is a command-line video downloader built on yt-dlp, supporting YouTube,
Vimeo, Twitter/X, TikTok, Instagram and 1000+ other sites.

### Fast by default

YouTube holds a download that asks for the whole file at once to about playback
speed. pull-vids requests streams in bounded 10 MB chunks, which YouTube serves
at full speed, and downloads the fragments of HLS/DASH streams in parallel. If
the server starts rejecting requests it backs off automatically.

### Features

* 1000+ supported sites via yt-dlp
* Quality selection from 360p through 2160p
* Audio-only extraction to mp3/m4a
* Transcripts as plain text, SRT or VTT, without downloading the video
* Playlist downloads
* Browser cookie support for authenticated content

### Dependencies

ffmpeg and yt-dlp are installed automatically as package dependencies.
aria2 is optional: install it only to use `--downloader aria2c`.
]]></description>
    <releaseNotes>https://github.com/vib795/pull-vids/releases</releaseNotes>

    <!-- Floors are set by the features actually relied on, not by the newest
         release (CPMR0052). A bare id would let an ancient build satisfy the
         dependency; pinning to latest would force needless upgrades. -->
    <dependencies>
      <!-- Only ever invoked by yt-dlp, for stream merging and audio extraction.
           Both are long-standing, so the floor is deliberately low. -->
      <dependency id="ffmpeg" version="4.0" />
      <!-- 2024.3.10 is the first yt-dlp release of 2024, and was checked to
           accept every option pull-vids passes, including print with the
           video stage alongside no-quiet and no-simulate. Newer builds are
           still better, because YouTube extractor changes break old ones. -->
      <dependency id="yt-dlp" version="2024.3.10" />
    </dependencies>
  </metadata>

  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
